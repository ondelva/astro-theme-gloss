---
// One row per post: date column, title, reading time, and the post's handwritten note.
// Home and archive share it; the archive groups by year, so it shows the month only.
import { formatYearMonth, postPath, type Post } from '../../lib/posts';

interface Props {
  posts: Post[];
  monthOnly?: boolean;
}
const { posts, monthOnly = false } = Astro.props;
const month = new Intl.DateTimeFormat('en', { month: 'short', timeZone: 'UTC' });
---

<ul class="border-border border-t">
  {posts.map((post) => (
    <li class="border-border grid grid-cols-[4.5rem_minmax(0,1fr)_auto] items-baseline gap-x-4 border-b py-3.5 max-sm:grid-cols-[minmax(0,1fr)_auto]">
      <time
        datetime={post.data.date.toISOString()}
        class="font-ui text-muted text-xs tabular-nums max-sm:col-span-2"
      >
        {monthOnly ? month.format(post.data.date) : formatYearMonth(post.data.date)}
      </time>
      <a href={postPath(post)} class="text-lg leading-snug no-underline hover:underline">
        {post.data.title}
      </a>
      <span class="font-ui text-muted text-sm tabular-nums">{post.minutes} min</span>
      {post.data.note && (
        <span class="hand col-start-2 text-[1.3125rem] max-sm:col-start-1 max-sm:col-span-2">
          {post.data.note}
        </span>
      )}
    </li>
  ))}
</ul>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GlossBody from '../../components/gloss/GlossBody.astro';
import { site } from '../../config';
import { formatDate, getPosts, postPath, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first: the later post is one up the list, the earlier one down.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, ogImage } = post.data;
const { Content } = await render(post);
const url = new URL(postPath(post), Astro.site).href;
---

<Base
  title={title}
  description={description}
  image={ogImage}
  type="article"
  jsonLd={[
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: date.toISOString(),
      ...(updated && { dateModified: updated.toISOString() }),
      author: { '@type': 'Person', name: site.author },
      mainEntityOfPage: url,
      wordCount: post.words,
    },
  ]}
>
  <article class="page pt-14 sm:pt-20">
    <header class="max-w-content mb-10">
      <h1 class="text-[clamp(2rem,5vw,2.75rem)] leading-[1.1] font-bold tracking-tight">{title}</h1>
      <p class="text-muted mt-3 text-xl italic">{description}</p>
      <p class="font-ui text-muted mt-5 text-sm tabular-nums">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {' · '}
        {post.minutes} min read
        {' · '}
        {post.words.toLocaleString('en')} words
        {updated && (
          <>
            {' · '}
            updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
          </>
        )}
      </p>
    </header>

    <GlossBody>
      <Content />
    </GlossBody>

    <footer class="max-w-content font-ui mt-12 text-sm">
      {tags.length > 0 && <p class="text-muted">Filed under {tags.join(', ')}</p>}
      {(newer || older) && (
        <nav
          aria-label="More essays"
          class="border-border mt-6 grid gap-4 border-t pt-5 sm:grid-cols-2"
        >
          {older && (
            <a href={postPath(older)} rel="prev" class="group no-underline">
              <span class="text-muted block">Earlier</span>
              <span class="font-prose text-foreground text-lg group-hover:underline">
                {older.data.title}
              </span>
            </a>
          )}
          {newer && (
            <a
              href={postPath(newer)}
              rel="next"
              class="group no-underline sm:col-start-2 sm:text-end"
            >
              <span class="text-muted block">Later</span>
              <span class="font-prose text-foreground text-lg group-hover:underline">
                {newer.data.title}
              </span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>
</Base>

---
import Base from '../layouts/Base.astro';
import { ui } from '../config';

const t = ui.notFound;
---

<Base title={t.title} noindex>
  <div class="page max-w-content pt-20 pb-8">
    <h1 class="text-4xl font-bold">{t.title}</h1>
    <p class="text-muted mt-4 text-lg">{t.text}</p>
    <p class="hand mt-4 -rotate-1 text-2xl">{t.hand}</p>
    <p class="font-ui mt-6 text-sm">
      <a href="/posts" class="underline">
        {t.allEssays}
      </a>
      {' · '}
      <a href="/" class="underline">
        {t.home}
      </a>
    </p>
  </div>
</Base>
